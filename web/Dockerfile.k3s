# syntax=docker/dockerfile:1
FROM node:24-alpine AS browser
WORKDIR /src
COPY web/otel/package*.json ./
RUN npm ci
COPY web/otel/browser.js ./
RUN npm run build

FROM alpine:3.24
ADD --checksum=sha256:ff7cf138acc09f2a5029300ab713fe6a1440605fca72e2bab76a4da9206fec87 https://nginx.org/keys/nginx_signing.rsa.pub /etc/apk/keys/nginx_signing.rsa.pub
RUN apk upgrade --no-cache && echo '@nginx https://nginx.org/packages/alpine/v3.24/main' >> /etc/apk/repositories && apk add --no-cache nginx@nginx nginx-module-otel@nginx
COPY web/nginx.k3s.main.conf /etc/nginx/nginx.conf
COPY web/nginx.k3s.conf /etc/nginx/conf.d/default.conf
COPY web/site1/index.html /usr/share/nginx/html/index.html
COPY web/catalog.js web/catalog.css /usr/share/nginx/
COPY --from=browser /src/dist/telemetry.js /usr/share/nginx/html/telemetry.js
RUN sed -i '/<head>/a\  <script src="/telemetry.js"></script>' /usr/share/nginx/html/index.html
USER 101:101
EXPOSE 8080
ENTRYPOINT ["nginx"]
CMD ["-g","daemon off;"]
